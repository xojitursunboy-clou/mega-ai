{
  "buildCommand": "prisma generate && next build",
  "devCommand": "next dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["fra1"],
  "env": {
    "NEXT_PUBLIC_SUPABASE_URL": "@megaai_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@megaai_supabase_anon_key",
    "SUPABASE_SERVICE_ROLE_KEY": "@megaai_supabase_service_role_key",
    "OPENAI_API_KEY": "@megaai_openai_api_key",
    "JWT_SECRET": "@megaai_jwt_secret",
    "ADMIN_USERNAME": "@megaai_admin_username",
    "ADMIN_CODE": "@megaai_admin_code",
    "DATABASE_URL": "@megaai_database_url",
    "DIRECT_URL": "@megaai_direct_url"
  }
}
